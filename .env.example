# ==============================================================================
# Voice-to-Cloud Architecture Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides. Do NOT commit .env to version control.

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Leave blank for local development to use the built-in Vite reverse proxy (/api)
# Set to full backend URL for production deployment (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Port for the FastAPI server (default: 8000)
PORT=

# Allowed CORS origins, comma-separated (e.g., https://yourdomain.com,http://localhost:5173)
# Leave blank during local development to allow standard localhost dev ports
CORS_ORIGINS=

# Database Connection URL (SQLAlchemy compatible)
# Defaults to local SQLite file: sqlite:///backend/database/architecture_studio.db
# For PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# ------------------------------------------------------------------------------
# Optional AI & Cloud Provider Integrations
# ------------------------------------------------------------------------------
# Optional external LLM API key for edge worker expansion
LLM_API_KEY=

# Optional Cloud credentials for live billing / IaC deployment validation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
