# ==============================================================================
# Voice-to-Cloud Architecture Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides. Do NOT commit .env to version control.

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Leave blank for local development to use the built-in Vite reverse proxy (/api)
# Set to full backend URL for production deployment (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Port for the FastAPI server (default: 8000)
PORT=8000

# Allowed CORS origins, comma-separated (e.g., https://yourdomain.com,http://localhost:5173)
# Leave blank during local development to allow standard localhost dev ports
CORS_ORIGINS=

# Database Connection URL (SQLAlchemy compatible)
# Defaults to local SQLite file: sqlite:///backend/database/architecture_studio.db
# For PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///backend/database/architecture_studio.db

# ------------------------------------------------------------------------------
# Multi-Provider AI Fallback Routing
# ------------------------------------------------------------------------------
# Primary and backup providers: 'gemini', 'openai', 'anthropic', 'groq'
# If a provider reaches rate limits or quota, system automatically fails over to backup.
# If external keys are absent, system automatically uses guaranteed local rule engine.
AI_PRIMARY_PROVIDER=gemini
AI_BACKUP_PROVIDER=openai

# Optional external LLM API Keys (API keys remain securely on backend only)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Optional Cloud Credentials (for live billing validation or Terraform deployments)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
